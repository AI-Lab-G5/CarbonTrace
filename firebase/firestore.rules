rules_version = '2';

// Regras de seguranca do Firestore -- CarbonTrace.
//
// O acesso ao Firestore passa pela API, que ja valida identidade e
// tenant. Estas regras sao a segunda barreira, para o caso de alguem
// chamar o Firestore direto do navegador -- e a unica que continua de pe
// se a API tiver um defeito de autorizacao.
//
// Atualizado no CP2: a colecao de dados passou de 'registros' para
// 'consumos' e o unico papel do sistema e 'funcionario' (ver
// docs/planejamento-checkpoint-2.md). Quem valida estas regras contra o
// emulador e o QA, na issue #24.

service cloud.firestore {
  match /databases/{database}/documents {

    // Fatores de emissao: publicos para leitura, nunca gravados pelo cliente.
    // Publicar versao nova e operacao administrativa, feita fora do app.
    match /fatores/{versao} {
      allow read: if true;
      allow write: if false;
    }

    // Dados de cliente. O tenant vem da custom claim do token, assinada pelo
    // Firebase -- o cliente nao consegue forjar a sua. Nenhuma regra aqui
    // confia em campo enviado no pedido.
    match /tenants/{tenantId}/{documento=**} {
      allow read: if pertenceAoTenant(tenantId);
      allow write: if pertenceAoTenant(tenantId) && podeEscrever();
    }

    // Qualquer caminho nao previsto acima e negado.
    match /{documento=**} {
      allow read, write: if false;
    }

    function pertenceAoTenant(tenantId) {
      return request.auth != null
          && request.auth.token.tenant_id == tenantId;
    }

    // Um unico papel no CP2. Os antigos 'operador' e 'gestor' saíram
    // junto com a gestao de usuarios, que ficou fora do recorte.
    function podeEscrever() {
      return request.auth.token.papel == 'funcionario';
    }
  }
}
