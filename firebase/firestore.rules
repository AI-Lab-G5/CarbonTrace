rules_version = '2';

// Regras de seguranca do Firestore -- CarbonTrace.
//
// DENY-ALL. Nenhum cliente le ou escreve nada diretamente.
//
// Por que deny-all e nao "cada tenant acessa o seu":
//
// Todo acesso do produto passa pela API, que valida o ID token, resolve
// o tenant pela custom claim e responde por rota propria. O frontend
// nao abre conexao com o Firestore em lugar nenhum -- so com o Auth,
// que nao passa por estas regras.
//
// Com o cliente fora do caminho, permitir leitura direta do tenant nao
// compra nada e custa caro: cria uma segunda superficie de autorizacao,
// com regra propria, que precisaria ser mantida em paralelo a API para
// sempre. Duas fontes de verdade sobre permissao e como se descobre um
// vazamento em producao.
//
// A API continua funcionando: o Admin SDK ignora Security Rules por
// definicao. Estas regras valem so para acesso de cliente.
//
// Provado por qa/test_deny_all.py (CA-03 do #13, CA-04 do #24):
// anonimo e usuario autenticado recebem 403 em leitura e escrita, e o
// Admin SDK continua lendo e gravando.

service cloud.firestore {
  match /databases/{database}/documents {

    // Nenhuma excecao. Nem fatores, nem tenants, nem colecao nova que
    // alguem crie amanha sem pensar nas regras.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
