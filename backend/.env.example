# Copie para .env e ajuste. O .env real NUNCA vai para o Git.

# Projeto do Firebase. O prefixo "demo-" faz o emulador rodar totalmente
# offline, sem tentar alcancar a nuvem e sem gastar cota.
FIREBASE_PROJECT_ID=demo-carbontrace

# Emuladores locais. Com estas variaveis definidas, os SDKs do Google
# conectam no emulador e ignoram qualquer credencial de producao.
FIREBASE_API_KEY=pseudo-chave
FIREBASE_AUTH_EMULATOR_HOST=https://localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080
API_PORT:3001
VITE_API_URL=http://localhost:3001

# emulator  -> aceita X-Debug-Uid / X-Debug-Tenant (so para desenvolvimento)
# firebase  -> exige ID token assinado pelo Firebase Auth
AUTH_MODE=emulator

CORS_ORIGINS=http://localhost:3000
