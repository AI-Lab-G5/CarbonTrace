# Base da API no frontend (relativo para passar pelo proxy do Vite em dev ou Nginx no container)
VITE_API_BASE_URL=/api

# Destino do proxy reverso no servidor de desenvolvimento Vite
VITE_PROXY_TARGET=http://localhost:8000

# Porta do servidor Vite em desenvolvimento
PORT=3000

# Configuração local do Firebase Auth (resolvida no build Vite).
VITE_FIREBASE_PROJECT_ID=demo-carbontrace
VITE_FIREBASE_API_KEY=demo-carbontrace-key
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# emulator (local) ou firebase (projeto real; exige os três valores abaixo)
VITE_AUTH_MODE=emulator
VITE_FIREBASE_AUTH_DOMAIN=demo-carbontrace.firebaseapp.com

# Publicação (preencher com valores fornecidos pela equipe, antes do build):
# VITE_API_BASE_URL=https://<servico-da-equipe>.onrender.com
# VITE_AUTH_MODE=firebase
# VITE_FIREBASE_PROJECT_ID=<projeto-spark>
# VITE_FIREBASE_API_KEY=<web-api-key>
# VITE_FIREBASE_AUTH_DOMAIN=<auth-domain-autorizado>
# API pública: sem FIREBASE_AUTH_EMULATOR_HOST; CORS/domínios em #34/#37.
# VITE_* em environment do Nginx não reconfigura um bundle já compilado.
